# macOS
.DS_Store

# Node, in the canonical template's own forms: unanchored, so a package that
# gains an output directory is covered the day it does rather than the day
# someone remembers this file.
logs
*.log
coverage
*.lcov
.nyc_output
node_modules/
.pnpm-store
*.tsbuildinfo
dist
out
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# The build outputs this repository names for itself, beside the template's
# dist and out. .build/ is the repository's own scratch: evidence.sh reads the
# icon there.
.build/
dist-server/
dist-functions/

# Generated evidence is never committed; a pull request links it from CI.
artifacts/

# Local secrets. Commit an explicit example file when configuration needs one.
.env
.env.*
!.env.example
# An APNs key is pasted into the deployment's environment, never committed.
*.p8

# Local agent context is not a repository input.
.context/

# Local build and agent state, never inputs
.turbo/
.vercel/
.eve/
.output/

# An agent tool's shared configuration is a repository input and its per-machine
# state is not, so these directories are ignored by file rather than whole. The
# Claude pattern matches .claude/* rather than the directory itself, because Git
# does not descend into an excluded directory to re-include a file inside it.
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/hooks/
!.claude/rules/
!.claude/settings.json
!.claude/skills/

# The iOS app's native project, which Expo generates from apps/mobile/app.config.ts
# on every build, its Metro state, and Xcode's own per-user and build state.
apps/mobile/ios/
# The options Sentry's native half starts on at launch, which the config plugin
# writes beside app.config.ts on every prebuild, the build's DSN among them.
apps/mobile/sentry.options.json
apps/mobile/android/
.expo/
expo-env.d.ts
xcuserdata/
DerivedData/
