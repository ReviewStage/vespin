{
  "type": "object",
  "properties": {
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "The thread's id, as read_inbox answered it."
    },
    "askId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "The id of the message whose ask you answer: the thread's askId, as read_inbox answered it."
    },
    "answer": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reply": {
              "type": "string",
              "enum": [
                "chose"
              ]
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 6,
              "description": "The labels of the options the member picks: one, or several where the ask lets several be picked."
            }
          },
          "required": [
            "reply",
            "choices"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "reply": {
              "type": "string",
              "enum": [
                "answered"
              ]
            }
          },
          "required": [
            "reply"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "reply": {
              "type": "string",
              "enum": [
                "submitted"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 1000
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              },
              "maxItems": 50,
              "description": "The fields the member fills: each by its field's label, with words, a number, one of a select's options, or true or false, as its type asks; every required field filled."
            }
          },
          "required": [
            "reply",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "reply": {
              "type": "string",
              "enum": [
                "done"
              ]
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMaximum": 50
              },
              "maxItems": 50,
              "description": "The steps of the do the member did, by their places from 0: every one."
            }
          },
          "required": [
            "reply",
            "steps"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "reply": {
              "type": "string",
              "enum": [
                "not-done"
              ]
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMaximum": 50
              },
              "maxItems": 50,
              "description": "The steps of the do the member did, by their places from 0: those they did, or none."
            }
          },
          "required": [
            "reply",
            "steps"
          ],
          "additionalProperties": false
        }
      ],
      "description": "How the member answers, by its reply: chose, with choices, for a decide; answered, with their words in note, where no option of a decide fits or an answer asks no fields; submitted, with values, for an answer's fields; and done or not-done, with steps, for a do."
    },
    "note": {
      "type": "string",
      "maxLength": 8000,
      "description": "The member's words with the answer, in Markdown: the answer itself for answered, and otherwise anything they add; none where left out."
    }
  },
  "required": [
    "threadId",
    "askId",
    "answer"
  ],
  "additionalProperties": false
}
