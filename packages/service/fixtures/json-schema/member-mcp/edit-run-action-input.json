{
  "type": "object",
  "properties": {
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "description": "The workspace whose setup it is, by the slug list_workspaces answered."
    },
    "repository": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9])*\\/(?!\\.{1,2}$)[A-Za-z0-9_.-]+$",
      "description": "The repository whose run actions to edit, as owner/name, under any casing of its name."
    },
    "edit": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "add"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "What the Run menu and the action's Terminal tab call it."
            },
            "command": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "\\S",
              "description": "The bash it runs from the repository's checkout, with the workspace's environment variables, such as pnpm dev."
            },
            "icon": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "emoji"
                          ]
                        },
                        "emoji": {
                          "type": "string",
                          "maxLength": 32
                        }
                      },
                      "required": [
                        "kind",
                        "emoji"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "glyph"
                          ]
                        },
                        "glyph": {
                          "type": "string",
                          "maxLength": 64,
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        },
                        "color": {
                          "type": "string",
                          "enum": [
                            "red",
                            "orange",
                            "yellow",
                            "green",
                            "teal",
                            "blue",
                            "purple",
                            "pink"
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "glyph"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "The icon it wears in the Run menu, one emoji or one Lucide icon by its kebab-case name in a color or none, such as rocket; null for the menu's own."
            },
            "isDefault": {
              "type": "boolean",
              "description": "true to make it the repository's default, which the Run button runs, so no other action is; false to make it no longer the default."
            },
            "position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19,
              "description": "Its place in the list after the edit, from 0, a place past the end being the last; an added action goes last and a changed one stays where it stood where left out."
            }
          },
          "required": [
            "operation",
            "label",
            "command"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "change"
              ]
            },
            "actionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "description": "The action, by the id read_sandbox_setup answered."
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "What the Run menu and the action's Terminal tab call it."
            },
            "command": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "\\S",
              "description": "The bash it runs from the repository's checkout, with the workspace's environment variables, such as pnpm dev."
            },
            "icon": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "emoji"
                          ]
                        },
                        "emoji": {
                          "type": "string",
                          "maxLength": 32
                        }
                      },
                      "required": [
                        "kind",
                        "emoji"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "glyph"
                          ]
                        },
                        "glyph": {
                          "type": "string",
                          "maxLength": 64,
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        },
                        "color": {
                          "type": "string",
                          "enum": [
                            "red",
                            "orange",
                            "yellow",
                            "green",
                            "teal",
                            "blue",
                            "purple",
                            "pink"
                          ]
                        }
                      },
                      "required": [
                        "kind",
                        "glyph"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "The icon it wears in the Run menu, one emoji or one Lucide icon by its kebab-case name in a color or none, such as rocket; null for the menu's own."
            },
            "isDefault": {
              "type": "boolean",
              "description": "true to make it the repository's default, which the Run button runs, so no other action is; false to make it no longer the default."
            },
            "position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 19,
              "description": "Its place in the list after the edit, from 0, a place past the end being the last; an added action goes last and a changed one stays where it stood where left out."
            }
          },
          "required": [
            "operation",
            "actionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "remove"
              ]
            },
            "actionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 36,
              "description": "The action, by the id read_sandbox_setup answered."
            }
          },
          "required": [
            "operation",
            "actionId"
          ],
          "additionalProperties": false
        }
      ],
      "description": "The edit, by its operation, with only the fields it takes: add (label, command, and optionally icon, isDefault, and position); change (actionId, and any of label, command, icon, isDefault, and position, each left out unchanged); or remove (actionId)."
    }
  },
  "required": [
    "workspace",
    "repository",
    "edit"
  ],
  "additionalProperties": false
}
