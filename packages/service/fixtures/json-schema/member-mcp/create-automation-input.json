              ]
            },
            "provider": {
              "type": "string",
              "enum": [
                "sentry"
              ]
            },
            "event": {
              "type": "string",
              "enum": [
                "alert-triggered",
                "issue-created"
              ]
            },
            "filters": {
              "type": "object",
              "properties": {
                "project": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "maxItems": 10
                },
                "environment": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "maxItems": 10
                },
                "level": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "debug",
                      "info",
                      "warning",
                      "error",
                      "fatal"
                    ]
                  },
                  "maxItems": 10
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "provider",
            "event"
          ],
          "additionalProperties": false
        }
      ],
      "description": "cron: five fields in an IANA timezone, at most every fifteen minutes; or at, a date and time on that zone's clock, to run once, after which it is paused. GitHub: senders names whose events fire it, of people, app-agents (our agents), and other-bots (for pull-request-merged, whose pull request it is), on every event but check-failed; drafts on pull-request-opened, -labeled, and -updated, forks on every pull-request event, and prereleases on release-published say whether a draft, a fork's pull request, or a prerelease fires it. moments (pull-request-updated only) left out is every moment; tags match a release's tag exactly. Sentry: prefer alert-triggered, fired by an alert rule whose action is \"Send a notification via Vespin\"; issue-created fires on every new issue. A filter matches any of its values, and every filter given must. Webhooks are made only on the automations page."
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 140,
        "pattern": "^[A-Za-z0-9](?:-?[A-Za-z0-9])*\\/(?!\\.{1,2}$)[A-Za-z0-9_.-]+$"
      },
      "maxItems": 10,
      "description": "owner/name, reached by the workspace's GitHub installation; runs start in the first. [] for none, which a GitHub trigger cannot take."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Catalog id from list_models, given with effort."
    },
    "effort": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "disabledServers": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 32,
      "description": "The member's connections each run's agent is not handed, by what they connect, such as neon, sentry, or notion-2 for a second Notion account; the whole list."
    },
    "agentId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 36
        },
        {
          "type": "null"
        }
      ],
      "description": "Hand every run to this agent, by its list_agents id, so runs share its memory; null for a new agent each run, the default."
    },
    "scope": {
      "type": "string",
      "enum": [
        "personal",
        "workspace"
      ],
      "description": "personal is its creator's alone; workspace is every member's."
    },
    "archiveSuccessful": {
      "type": "boolean",
      "description": "Where each run starts a new agent, mark the run's task Done, archiving its agents, once every agent of the run succeeds and leaves no pull request or thread open."
    },
    "slackDelivery": {
      "type": "boolean",
      "description": "Send each run's result to the member on Slack from Vespin's bot, so the run's agent needs no Slack of its own; the workspace must have the bot connected."
    }
  },
  "required": [
    "name",
    "prompt",
    "trigger",
    "repositories",
    "model",
    "effort",
    "scope",
    "archiveSuccessful",
    "slackDelivery"
  ],
  "additionalProperties": false
}
