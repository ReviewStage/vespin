    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/types": "18.0.0",
    "bottleneck": "2.19.5",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@repo/wire": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
