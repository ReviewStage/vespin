{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "packages/agent-runner/src/codex-protocol/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    }
  ],
  "rules": {
    "unicorn/no-useless-spread": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@repo/ui/icons", "lucide-react", "lucide-react/**"],
            "importNamePattern": "Sparkle",
            "message": "Never draw a sparkle, in any of its glyphs: draw the act's own glyph from `GLYPH`, such as `GLYPH.RETRY` for an act that runs again."
          }
        ]
      }
    ],
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-chained-type-assertions": "off",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-known-value-widening": "off",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop/no-shape-in-symbol-names": "off",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop-effect/no-manual-effect-error-tag": "error",
    "anti-slop-effect/no-manual-tagged-construction": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "anti-slop-effect/prefer-effect-match": "error",
    "anti-slop-effect/no-manual-tag-comparison": "error"
  },
  "overrides": [
    {
      "files": ["packages/ui/src/icons/icons.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/mobile/**", "packages/ui-native/**"],
      "plugins": ["react"],
      "rules": {
        "react/refs": "error",
        "react/immutability": "off",
        "react/preserve-manual-memoization": "off",
        "react/purity": "off",
        "react/set-state-in-effect": "off",
        "react/use-memo": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    }
  ]
}
