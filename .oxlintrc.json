{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "packages/agent-runner/src/codex-protocol/**",
    "tools/oxlint/anti-slop/**",
    "tools/oxlint/vespin/**"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    },
    {
      "name": "vespin",
      "specifier": "./tools/oxlint/vespin/index.ts"
    }
  ],
  "rules": {
    "unicorn/no-useless-spread": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@repo/ui/icons", "lucide-react", "lucide-react/**"],
            "importNamePattern": "Sparkle",
            "message": "Never draw a sparkle, in any of its glyphs: draw the act's own glyph from `GLYPH`, such as `GLYPH.RETRY` for an act that runs again."
          }
        ]
      }
    ],
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-trailing-newline-regex": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop-effect/no-manual-effect-error-tag": "error",
    "anti-slop-effect/no-manual-tagged-construction": "error",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "anti-slop-effect/prefer-effect-match": "error",
    "anti-slop-effect/no-manual-tag-comparison": "error",
    "vespin/agent-box-reads-agent": "error",
    "vespin/archive-through-agent-change": "error",
    "vespin/ask-beside-screen": "error",
    "vespin/async-press-needs-busy": "error",
    "vespin/enforce-delete-with-where": "error",
    "vespin/enforce-update-with-where": "error",
    "vespin/no-browser-form-validation": "error",
    "vespin/no-direct-view-storage": "error",
    "vespin/no-document-press-listener": "error",
    "vespin/no-focused-or-skipped-test": "error",
    "vespin/no-follow-outside-host-read": "error",
    "vespin/no-hand-written-arrow-keys": "error",
    "vespin/no-hand-written-live-region": "error",
    "vespin/no-lucide-outside-door": "error",
    "vespin/no-node-test": "error",
    "vespin/no-open-page-from-button": "error",
    "vespin/no-placeholder-ellipsis": "error",
    "vespin/no-product-name": "error",
    "vespin/no-raw-heading-outside-ui": "error",
    "vespin/no-raw-press-outside-ui": "error",
    "vespin/no-raw-press-outside-ui-native": "error",
    "vespin/no-reduced-motion-query": "error",
    "vespin/no-shadcn-focus-ring": "error",
    "vespin/no-shortcut-flag": "error",
    "vespin/no-source-read-in-test": "error",
    "vespin/one-message-box": "error",
    "vespin/retired": "error",
    "vespin/row-behavior-in-row": "error",
    "vespin/sandbox-delete-in-one-place": "error",
    "vespin/settings-row-end": "error",
    "vespin/settings-section-declared": "error",
    "vespin/skeleton-through-components": "error"
  },
  "overrides": [
    {
      "files": ["packages/ui/src/icons/icons.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/mobile/**", "packages/ui-native/**"],
      "plugins": ["react"],
      "rules": {
        "react/refs": "error",
        "react/immutability": "off",
        "react/preserve-manual-memoization": "off",
        "react/purity": "off",
        "react/set-state-in-effect": "off",
        "react/use-memo": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.mjs", "**/*.test.tsx"],
      "rules": {
        "vespin/enforce-delete-with-where": "off"
      }
    }
  ]
}
