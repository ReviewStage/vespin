{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [".agents/**", ".claude/**", "packages/agent-runner/src/codex-protocol/**"],
  "rules": {
    "unicorn/no-useless-spread": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@repo/ui/icons", "lucide-react", "lucide-react/**"],
            "importNamePattern": "Sparkle",
            "message": "Never draw a sparkle, in any of its glyphs: draw the act's own glyph from `GLYPH`, such as `GLYPH.RETRY` for an act that runs again."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/ui/src/icons/icons.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/mobile/**", "packages/ui-native/**"],
      "plugins": ["react"],
      "rules": {
        "react/refs": "error",
        "react/immutability": "off",
        "react/preserve-manual-memoization": "off",
        "react/purity": "off",
        "react/set-state-in-effect": "off",
        "react/use-memo": "off",
        "react-hooks/exhaustive-deps": "off"
      }
    }
  ]
}
