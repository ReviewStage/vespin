{
  "name": "@repo/desktop",
  "productName": "Vespin",
  "version": "0.42.0",
  "private": true,
  "description": "Vespin desktop application",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "package": "pnpm build:native && pnpm build && node scripts/package-host.mjs && node scripts/prepare-builder-assets.mjs && electron-builder --config electron-builder.ts --mac --arm64 --publish never",
    "package:dir": "pnpm build:native && pnpm build && node scripts/package-host.mjs && node scripts/prepare-builder-assets.mjs && electron-builder --config electron-builder.ts --mac --arm64 --dir --publish never",
    "release": "APP_ELECTRON_BUILDER_NOTARIZE=1 pnpm package",
    "start": "pnpm build:native && pnpm build && electron .",
    "test:vitest": "vitest run",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@electron/osx-sign": "1.3.3",
    "@repo/brand": "workspace:*",
    "@repo/credentials": "workspace:*",
    "@repo/features": "workspace:*",
    "@repo/gateway": "workspace:*",
    "@repo/host": "workspace:*",
    "@repo/panel": "workspace:*",
    "@repo/settings": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/wire": "workspace:*",
    "@sentry/cli": "2.58.6",
    "@tailwindcss/node": "4.3.5",
    "@tanstack/react-query": "catalog:",
    "@tailwindcss/oxide": "4.3.5",
    "@tanstack/react-router": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "effect": "catalog:",
    "electron": "43.8.9",
    "electron-builder": "26.18.1",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "node-pty": "1.1.0",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@sentry/electron": "8.3.0",
    "electron-updater": "6.8.12"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "1.1.1"
  }
}
