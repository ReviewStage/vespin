{
  "name": "@repo/web",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "description": "Vespin's web app and public site, the Vercel function routes behind them, and the deployment shell",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "agent-image": "tsx scripts/agent-image.ts",
    "auth:seed": "tsx server/seed-clients.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && tsx scripts/prerender.ts && pnpm --filter @repo/agent-runner build && pnpm --filter @repo/agent-runner upload:source-maps && tsx scripts/bundle-functions.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "demo:seed": "tsx server/demo-seed.ts",
    "dev": "vite",
    "functions:rewrites": "tsx scripts/function-rewrites.ts --write",
    "functions:externals": "tsx scripts/function-externals.ts --write",
    "local-server": "tsx scripts/local-server.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:vitest": "vitest run",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --project tsconfig.json"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@fontsource-variable/bricolage-grotesque": "catalog:",
    "@fontsource-variable/geist": "catalog:",
    "@fontsource-variable/geist-mono": "catalog:",
    "@repo/agent-runner": "workspace:*",
    "@repo/brand": "workspace:*",
    "@repo/credentials": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/features": "workspace:*",
    "@repo/host": "workspace:*",
    "@repo/panel": "workspace:*",
    "@repo/runtime": "workspace:*",
    "@repo/sandbox": "workspace:*",
    "@repo/service": "workspace:*",
    "@repo/settings": "workspace:*",
    "@repo/sync": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/wire": "workspace:*",
    "@sentry/browser": "11.7.0",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@vercel/functions": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@sentry/esbuild-plugin": "catalog:",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "catalog:",
    "fake-indexeddb": "6.2.8",
    "jsdom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:web",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1",
    "zod": "catalog:"
  }
}
