{
  "name": "@repo/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Vespin's iOS app: an Expo shell over the shared client host, drawn SwiftUI-first through @expo/ui",
  "main": "expo-router/entry",
  "scripts": {
    "export:ios": "EXPO_NO_TELEMETRY=1 expo export --platform ios --output-dir dist",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform ios",
    "start": "expo start",
    "test:vitest": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@expo/ui": "58.0.27",
    "@formatjs/intl-datetimeformat": "8.0.3",
    "@formatjs/intl-getcanonicallocales": "3.3.1",
    "@formatjs/intl-listformat": "9.0.2",
    "@formatjs/intl-locale": "5.4.3",
    "@formatjs/intl-numberformat": "10.0.3",
    "@formatjs/intl-pluralrules": "7.0.3",
    "@formatjs/intl-segmenter": "12.3.2",
    "@noble/ciphers": "2.3.0",
    "@orpc/client": "catalog:",
    "@repo/brand": "workspace:*",
    "@repo/credentials": "workspace:*",
    "@repo/features": "workspace:*",
    "@repo/host": "workspace:*",
    "@repo/settings": "workspace:*",
    "@repo/ui-native": "workspace:*",
    "@tanstack/react-query": "5.106.1",
    "effect": "catalog:",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-crypto": "58.0.7",
    "expo-file-system": "58.0.13",
    "expo-glass-effect": "58.0.5",
    "expo-haptics": "58.0.7",
    "expo-linking": "58.0.16",
    "expo-localization": "58.0.5",
    "expo-notifications": "58.1.8",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.13",
    "expo-symbols": "58.0.4",
    "expo-video": "58.0.13",
    "expo-web-browser": "58.0.7",
    "react": "catalog:mobile",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
