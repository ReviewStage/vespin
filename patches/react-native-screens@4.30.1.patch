   }
 
   self.viewControllers = currentViewControllers;
+  [self vespinUpdateSecondaryNavBarForDisplayMode:self.displayMode];
 
 #if RNS_IPHONE_OS_VERSION_AVAILABLE(26_0)
   if (@available(iOS 26.0, *)) {
@@ -159,7 +160,44 @@ static const NSInteger maxNumberOfInspectors = 1;
 
   /** The assumption is that it should come in a single batch and it won't cause any delays in rendering the content. */
   [navigationController setNavigationBarHidden:YES animated:NO];
-  [navigationController setNavigationBarHidden:NO animated:NO];
+  [navigationController setNavigationBarHidden:[self vespinHidesSecondaryNavBarInDisplayMode:self.displayMode]
+                                      animated:NO];
+}
+
+// Vespin: the secondary column's own navigation bar stands aside while the supplementary column stands beside or over
+// it in a three-column split, because the page in it brings its own native-stack header, which then stands as the
+// column's one bar, and the system places its display mode button in the leftmost visible column, never the secondary
+// while the supplementary stands. It stands again whenever the secondary stands alone or the split collapses, so the
+// button always keeps a bar. Delete this once expo-router adopts react-native-screens' Stack v5, whose `Stack.Host`
+// owns its Split column's navigation controller (react-native-screens#5215).
+- (BOOL)vespinHidesSecondaryNavBarInDisplayMode:(UISplitViewControllerDisplayMode)displayMode
+{
+  if (self.style != UISplitViewControllerStyleTripleColumn || self.isCollapsed) {
+    return NO;
+  }
+
+  switch (displayMode) {
+    case UISplitViewControllerDisplayModeOneBesideSecondary:
+    case UISplitViewControllerDisplayModeOneOverSecondary:
+    case UISplitViewControllerDisplayModeTwoBesideSecondary:
+    case UISplitViewControllerDisplayModeTwoOverSecondary:
+    case UISplitViewControllerDisplayModeTwoDisplaceSecondary:
+      return YES;
+    default:
+      return NO;
+  }
+}
+
+- (void)vespinUpdateSecondaryNavBarForDisplayMode:(UISplitViewControllerDisplayMode)displayMode
+{
+  UIViewController *secondaryViewController = [self viewControllerForColumn:UISplitViewControllerColumnSecondary];
+  if (![secondaryViewController isKindOfClass:UINavigationController.class]) {
+    return;
+  }
+
+  [(UINavigationController *)secondaryViewController
+      setNavigationBarHidden:[self vespinHidesSecondaryNavBarInDisplayMode:displayMode]
+                    animated:NO];
 }
 
