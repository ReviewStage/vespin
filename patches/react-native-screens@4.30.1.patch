+static UITabBarAppearance *RNSAppearanceWithBadgeColor(UITabBarAppearance *appearance, UIColor *badgeColor)
+{
+  UITabBarAppearance *colored = [appearance copy];
+  for (UITabBarItemAppearance *item in @[ colored.stackedLayoutAppearance, colored.inlineLayoutAppearance, colored.compactInlineLayoutAppearance ]) {
+    item.normal.badgeBackgroundColor = badgeColor;
+    item.selected.badgeBackgroundColor = badgeColor;
+  }
+  return colored;
+}
