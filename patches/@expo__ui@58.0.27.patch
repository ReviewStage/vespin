+  // A symbol already filled with its color, its rendering kept original, as Mail's Flag menu hands its flags to the menu.
+  private var originalImage: Image? {
+    guard let color = props.originalColor else {
+      return nil
+    }
+    let symbol = props.systemName.flatMap { UIImage(systemName: $0) } ?? props.assetName.flatMap { UIImage(named: $0) }
+    let ink = UIColor(color)
+    // A layered symbol is painted as a palette, its second layer the same ink made faint, as the panel draws a priority's unlit bars.
+    if let opacity = props.originalSecondaryOpacity,
+       let painted = symbol?.applyingSymbolConfiguration(
+         UIImage.SymbolConfiguration(paletteColors: [ink, ink.withAlphaComponent(CGFloat(opacity))])
+       ) {
+      return Image(uiImage: painted.withRenderingMode(.alwaysOriginal))
+    }
+    guard let tinted = symbol?.withTintColor(ink, renderingMode: .alwaysOriginal) else {
+      return nil
+    }
+    return Image(uiImage: tinted)
+  }
+
+  // A photo already drawn into its circle at its size, its rendering kept original, so a system menu, which templates an image and takes it at its own size, keeps it. Note that it reads only a file on this device, never the network, since the read is synchronous.
+  private var photoImage: Image? {
+    guard let side = props.photoSize, side > 0,
+          let path = props.uiImage, let url = URL(string: path), url.isFileURL,
+          let photo = UIImage(contentsOfFile: url.path),
+          photo.size.width > 0, photo.size.height > 0 else {
+      return nil
+    }
+    let size = CGSize(width: side, height: side)
+    let round = UIGraphicsImageRenderer(size: size).image { _ in
+      UIBezierPath(ovalIn: CGRect(origin: .zero, size: size)).addClip()
+      // The photo fills the circle, its longer side cropped about its center.
+      let scale = max(side / photo.size.width, side / photo.size.height)
+      let drawn = CGSize(width: photo.size.width * scale, height: photo.size.height * scale)
+      photo.draw(in: CGRect(origin: CGPoint(x: (side - drawn.width) / 2, y: (side - drawn.height) / 2), size: drawn))
+    }
+    return Image(uiImage: round.withRenderingMode(.alwaysOriginal))
+  }
