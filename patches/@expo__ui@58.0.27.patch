@@ -1402,6 +1402,22 @@ internal struct Badge: ViewModifier, Record {
   }
 }
 
+// Vespin's patch: the margins a scroll view stands its content in, while the
+// scroll view itself keeps its whole width, so a plain list framed at a
+// reading width still scrolls from the ground beside it.
+internal struct ScrollContentMargins: ViewModifier, Record {
+  @Field var length: CGFloat?
+  @Field var edges: EdgeOptions?
+
+  func body(content: Content) -> some View {
+    if #available(iOS 17.0, tvOS 17.0, macOS 14.0, *), let edges {
+      content.contentMargins(edges.toEdge(), length ?? 0, for: .scrollContent)
+    } else {
+      content
+    }
+  }
+}
+
 internal struct ListSectionMargins: ViewModifier, Record {
   @Field var length: CGFloat?
   @Field var edges: EdgeOptions?
