+
+/**
+ The name `String(describing:)` gives a metatype, without the protocol conformance probes and the `Mirror`
+ it runs, which every view made paid. Never inlined, so a statically known metatype's name is never folded
+ into one that keeps a private type's file discriminator, as expo-ui's `UIBaseView` names its views.
+ */
+@inline(never)
+private func unqualifiedComponentName(_ type: Any.Type) -> String {
+  return _typeName(type, qualified: false)
+}
